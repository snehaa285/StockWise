# Backend local development configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Activate the MySQL profile only when using a configured local database.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/stockwise?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# Base64-encoded random key (at least 32 bytes); supply through a secret manager or local environment.
STOCKWISE_JWT_SIGNING_SECRET=

# Separate Base64-encoded random key (at least 32 bytes) for refresh-cookie CSRF HMAC.
STOCKWISE_CSRF_HMAC_SECRET=

# Required when the mysql profile is active. Set explicitly for each deployment.
# Local HTTP development: false. Production HTTPS: true.
STOCKWISE_AUTH_REFRESH_COOKIE_SECURE=
# Choose only after confirming frontend/API deployment topology: Lax, Strict, or None.
STOCKWISE_AUTH_REFRESH_COOKIE_SAME_SITE=

# Firebase Admin SDK (Backend)
# Set your Firebase project ID to enable Google ID token verification on the backend.
# The backend uses Google Application Default Credentials (e.g., GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account.json>).
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Client SDK (Frontend)
# Configured in frontend/.env or client environment for Google Sign-In with popup.
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email invitations. Without a configured SMTP host, invitation requests fail explicitly.
# When enabled, also set SPRING_MAIL_USERNAME, SPRING_MAIL_PASSWORD,
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH, SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE,
# and STOCKWISE_EMAIL_FROM through the process environment or secret manager.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# STOCKWISE_EMAIL_FROM=
STOCKWISE_PUBLIC_URL=http://localhost:4173

# Business invitations. Email delivery is disabled until an SMTP provider is configured.
# SPRING_MAIL_HOST=
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# STOCKWISE_EMAIL_FROM=

# Microsoft Graph delegated OneDrive connection. Never place these in frontend/.env.
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8080/api/v1/excel-sync/microsoft/callback
# STOCKWISE_FRONTEND_URL=http://localhost:5173
# Generate a random 32-byte key locally, then Base64-encode it.
# STOCKWISE_MICROSOFT_TOKEN_ENCRYPTION_KEY=
# STOCKWISE_EXCEL_SYNC_POLL_INTERVAL_MS=5000

# Integration tests require this dedicated schema/user and never use DB_URL.
# AUTH_TEST_DB_URL=jdbc:mysql://localhost:3306/stockwise_auth_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# AUTH_TEST_DB_USERNAME=stockwise_auth_test_user
# AUTH_TEST_DB_PASSWORD=
